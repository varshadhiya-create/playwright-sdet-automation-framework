# Active environment: local | qa | staging
ENV=local

# Overrides (optional) — if unset, config/environments.ts defaults are used
BASE_URL=https://www.automationexercise.com
API_BASE_URL=https://www.automationexercise.com/api

# Test execution
HEADLESS=true
WORKERS=4
RETRIES=1

# Logging
LOG_LEVEL=info

# Reporting
ALLURE_RESULTS_DIR=allure-results

# Seeded account used by global-setup.ts to capture the storageState reused by the
# authenticatedPage fixture. In a real org, point this at a dedicated fixture/service
# account per environment rather than a personal account.
SEED_USER_NAME=SDET Fixture User
SEED_USER_EMAIL=sdet.fixture.local@mailinator.com
SEED_USER_PASSWORD=Fixture!Passw0rd
